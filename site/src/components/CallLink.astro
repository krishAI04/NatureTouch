---
// A phone or WhatsApp contact that reads as something to tap: a gold-ringed icon, a small label and the number in Gloock.
// Used wherever a number appears (hero, closing band, menu, footer, contact page).
import { company } from '../content/site';
interface Props { kind?: 'call' | 'whatsapp'; phone?: string; label?: string; size?: 'md' | 'lg'; class?: string }
const { kind = 'call', phone = company.phones[0], label, size = 'md', class: cls = '' } = Astro.props;
const digits = phone.replace(/[^\d+]/g, '');
const href = kind === 'whatsapp' ? company.whatsapp : `tel:${digits}`;
const text = label ?? (kind === 'whatsapp' ? 'WhatsApp us' : 'Call us');
---
<a class={`call call--${size} ${cls}`} href={href}>
  <span class="call__icon" aria-hidden="true">
    {kind === 'whatsapp'
      ? <svg viewBox="0 0 24 24"><path d="M12 3.2a8.8 8.8 0 0 0-7.6 13.2L3.3 20.7l4.4-1.1A8.8 8.8 0 1 0 12 3.2Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9.1 8.4c.3-.6.6-.6.9-.6h.6c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .5-.1.6l-.5.6c-.1.2-.1.4 0 .5.5.9 1.3 1.7 2.2 2.2.2.1.4.1.5 0l.6-.6c.2-.2.4-.2.6-.1l1.7.8c.2.1.4.3.3.5v.6c0 .4-.3.8-.7 1-.6.3-1.4.4-2.4 0-2-.8-3.6-2.4-4.4-4.4-.4-1-.4-1.9-.5-2.6 0-.4.1-.7.4-1Z" fill="currentColor"/></svg>
      : <svg viewBox="0 0 24 24"><path d="M6.6 3.5h2.2c.4 0 .8.3.9.7l.9 3.3c.1.4 0 .8-.3 1L8.8 9.7a12 12 0 0 0 5.5 5.5l1.2-1.5c.3-.3.7-.4 1-.3l3.3.9c.4.1.7.5.7.9v2.2c0 .8-.6 1.5-1.5 1.5A16.4 16.4 0 0 1 3.5 5c0-.8.7-1.5 1.5-1.5h1.6Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>}
  </span>
  <span class="call__text">
    <span class="call__label">{text}</span>
    <span class="call__num" translate="no">{phone}</span>
  </span>
</a>

<style>
  .call { display: inline-flex; align-items: center; gap: 12px; min-height: 56px; padding-right: 6px; text-decoration: none; color: var(--marble); }
  .call__icon {
    display: grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 50%;
    color: var(--gold); border: 1px solid color-mix(in srgb, var(--gold) 70%, transparent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--gold) 10%, transparent);
    transition: background-color 0.25s var(--ease-out), color 0.25s var(--ease-out), transform 0.16s var(--ease-out);
  }
  .call__icon svg { width: 20px; height: 20px; }
  .call__text { display: grid; gap: 3px; line-height: 1.1; }
  .call__label { font-size: 0.8rem; color: color-mix(in srgb, var(--marble) 72%, transparent); }
  .call__num { font: 400 1.22rem/1.1 var(--display); letter-spacing: 0.01em; }
  .call--lg .call__icon { width: 52px; height: 52px; }
  .call--lg .call__icon svg { width: 23px; height: 23px; }
  .call--lg .call__num { font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.6rem); }
  .call:active .call__icon { transform: scale(0.95); }
  .call:focus-visible { outline: 2px solid var(--channel); outline-offset: 4px; border-radius: 6px; }
  @media (hover: hover) and (pointer: fine) {
    .call:hover .call__icon { background: var(--gold); color: var(--garden-950); }
  }
  @media (prefers-reduced-motion: reduce) { .call__icon { transition: none; } }
</style>
