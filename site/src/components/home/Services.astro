---
import { Image } from 'astro:assets';
import { chapters } from '../../content/site';
import archUrl from '../../assets/svg/arch.svg?url';
import marble from '../../assets/textures/marble.jpg';
const s = import.meta.glob<{ default: ImageMetadata }>('../../assets/stickers/*.png', { eager: true });
const st = (n: string) => s[`../../assets/stickers/${n}.png`].default;
// the board behind the cards: stickers scattered like a designer's mood table
const board = [
  { n: 'bloom-bougainvillea', x: 6, y: 8, w: 15, r: -8 }, { n: 'plant-areca-palm', x: 74, y: 4, w: 14, r: 6 },
  { n: 'bloom-lotus', x: 40, y: 18, w: 13, r: 4 }, { n: 'plant-coleus', x: 82, y: 40, w: 13, r: -5 },
  { n: 'bloom-marigold', x: 12, y: 46, w: 11, r: 9 }, { n: 'plant-echeveria', x: 56, y: 52, w: 12, r: -3 },
  { n: 'bloom-hibiscus', x: 28, y: 72, w: 13, r: -6 }, { n: 'plant-cordyline', x: 70, y: 74, w: 13, r: 7 },
  { n: 'bloom-frangipani', x: 88, y: 84, w: 11, r: -10 }, { n: 'plant-pothos', x: 2, y: 82, w: 14, r: 3 },
];
import { wing } from '../../lib/ornament';
// each chapter's arch is a window onto real work that shows it
import aerial from '../../assets/projects/signature-home/01.jpg';
import fountain from '../../assets/projects/raipur-airport/01.jpg';
import pergola from '../../assets/projects/khanuj-khanna/01.jpg';
import dusk from '../../assets/scene/dusk-pergola.jpg';
const view: Record<string, { src: ImageMetadata; alt: string; pos: string }> = {
  'design-build': { src: aerial, alt: 'Aerial of the Signature Homes podium garden, drawn as one zigzag of paths and lawns', pos: '50% 50%' },
  water: { src: fountain, alt: 'A fountain and lawns in front of Raipur airport', pos: '50% 60%' },
  built: { src: pergola, alt: 'A timber pergola and deck at the Khanuj Khanna residence', pos: '50% 40%' },
  light: { src: dusk, alt: 'The same pergola at dusk with uplights and a warm pendant (illustration)', pos: '50% 45%' },
};
---
<section class="svc" aria-labelledby="svc-title" data-svc>
  <div class="svc__board" aria-hidden="true" data-svc-board>
    {board.map((b) => (
      <Image src={st(b.n)} alt="" widths={[240, 400]} sizes="15vw" class="svc__sticker" style={`left:${b.x}%;top:${b.y}%;--w:${b.w};transform:rotate(${b.r}deg)`} loading="lazy" />
    ))}
  </div>
  <div class="wrap svc__inner">
    <div class="svc__intro">
      <h2 id="svc-title">One team for the whole garden</h2>
      <p>Twelve services in four chapters, drawn by our architects and built by our own crews.</p>
    </div>
    <ol class="svc__chapters">
      {chapters.map((c) => (
        <li class={`svc__card n-${c.services.length}`} id={c.id} style={`--arch:url("${archUrl}");--marble-tex:url("${marble.src}")`}>
          <div class="svc__facade">
          <span class="svc__wing svc__wing--l" set:html={wing} />
          <div class="svc__niche">
            <Image src={view[c.id].src} alt={view[c.id].alt} widths={[320, 520]} sizes="220px" class="svc__view" style={`object-position:${view[c.id].pos}`} loading="lazy" />
          </div>
          <span class="svc__wing" set:html={wing} />
          </div>
          <h3>{c.title}</h3>
          <div class="svc__rule" aria-hidden="true"><span set:html={wing} class="svc__wing--l" /><i></i><span set:html={wing} /></div>
          <ul class="svc__list">
            {c.services.map((sv) => <li><span class="svc__name">{sv.name}</span><span class="svc__blurb">{sv.blurb}</span></li>)}
            {c.services.length === 4 && <li class="svc__pool" aria-hidden="true"></li>}
          </ul>
        </li>
      ))}
    </ol>
    <a class="link svc__all" href="/services/">All services</a>
  </div>
</section>

<style>
  .svc { position: relative; background: var(--garden-900); border-top: var(--channel-line); overflow: clip; }
  /* the board stays put while the chapter cards scroll over it, and softens as they pass */
  .svc__board { position: sticky; top: 0; height: 100svh; margin-bottom: -100svh; overflow: hidden; pointer-events: none; filter: blur(12px); opacity: 0.4; }
  .svc__sticker { position: absolute; width: calc(var(--w) * 1vw); height: auto; }
  .svc__inner { position: relative; padding-block: clamp(96px, 16vh, 180px); display: grid; gap: clamp(28px, 6vh, 64px); }
  .svc__intro { position: relative; z-index: 1; max-width: 46rem; padding: 22px 26px; background: var(--garden-950); border-radius: 6px; }
  h2 { font-size: var(--step-2); }
  .svc__intro p { margin-top: 12px; color: color-mix(in srgb, var(--marble) 88%, transparent); }
  .svc__chapters { list-style: none; margin: 0; padding: 48px 0 0; display: grid; gap: clamp(64px, 12vh, 140px); }
  /* each chapter is a garden panel: an arched niche, a marble body with a sandstone inlay,
     and the services laid out as a char-bagh, quadrants split by water channels meeting at a pool */
  .svc__card {
    position: relative; z-index: 1; width: min(100%, 680px); padding: 0 clamp(18px, 3vw, 34px) clamp(24px, 3vw, 34px);
    text-align: center; color: var(--ink); border-radius: 6px;
    background-color: var(--marble); background-image: var(--marble-tex); background-size: cover; background-position: center;
    box-shadow: inset 0 0 0 8px var(--marble), inset 0 0 0 9px color-mix(in srgb, var(--sandstone) 55%, transparent),
                inset 0 0 0 13px var(--marble), inset 0 0 0 14px color-mix(in srgb, var(--sandstone) 30%, transparent),
                0 30px 60px -30px rgb(0 0 0 / 0.6);
  }
  .svc__card:nth-child(even) { margin-left: auto; }
  /* a jharokha: a sandstone-framed arch window inside the marble, looking onto real work */
  .svc__niche {
    position: relative; flex: none; width: clamp(170px, 30vw, 230px); aspect-ratio: 100 / 118;
    background-color: var(--sandstone); padding: 5px;
    -webkit-mask-image: var(--arch); mask-image: var(--arch);
    -webkit-mask-size: 100% 100%; mask-size: 100% 100%; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
  }
  .svc__view {
    width: 100%; height: 100%; object-fit: cover; display: block;
    -webkit-mask-image: var(--arch); mask-image: var(--arch);
    -webkit-mask-size: 100% 100%; mask-size: 100% 100%; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
  }
  /* the photo window with calligraphic flourishes reaching out from its sides, and a matching rule under the title */
  .svc__facade { display: flex; justify-content: center; align-items: end; margin-top: clamp(26px, 3vw, 36px); }
  .svc__wing { color: var(--sandstone); display: block; flex: none; }
  .svc__facade .svc__wing { width: clamp(90px, 13vw, 160px); margin-bottom: 20%; margin-inline: 8px; }
  .svc__wing :global(svg) { display: block; width: 100%; height: auto; }
  .svc__wing--l :global(svg) { transform: scaleX(-1); }
  .svc__rule { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: 10px; color: var(--sandstone); }
  .svc__rule span { width: clamp(90px, 11vw, 140px); }
  .svc__rule i { width: 8px; height: 8px; background: currentColor; transform: rotate(45deg); flex: none; }
  h3 { font-size: var(--step-2); margin-top: 18px; }

  .svc__list {
    list-style: none; margin: 22px 0 0; padding: 0; position: relative; text-align: left;
    display: grid; grid-template-columns: 1fr 1fr;
  }
  .svc__list li:not(.svc__pool) { padding: 16px 18px; }
  /* water channels between the beds */
  .svc__list li:nth-child(odd):not(:last-child):not(.svc__pool) { border-right: 2px solid var(--channel); }
  .svc__list li:nth-child(n+3):not(.svc__pool) { border-top: 2px solid var(--channel); }
  .n-4 .svc__list li:nth-child(3) { border-right: 2px solid var(--channel); }
  .n-5 .svc__list li:nth-child(5) { grid-column: 1 / -1; text-align: center; }
  .n-1 .svc__list { grid-template-columns: 1fr; }
  .n-1 .svc__list li { text-align: center; border: 0 !important; }
  .n-2 .svc__list li:first-child { border-right: 2px solid var(--channel); }
  .svc__pool {
    position: absolute; left: 50%; top: 50%; width: 22px; height: 22px; transform: translate(-50%, -50%) rotate(45deg);
    background: var(--marble); border: 2px solid var(--channel); box-shadow: 0 0 0 4px var(--marble);
  }
  .svc__name { display: block; font-weight: 650; line-height: 1.3; }
  .svc__blurb { display: block; margin-top: 4px; font-size: var(--step--1); color: color-mix(in srgb, var(--ink) 78%, transparent); }
  .svc__all { justify-self: start; background-color: transparent; }
  @media (max-width: 899px) {
    .svc__sticker { width: calc(var(--w) * 2.2vw); }
    .svc__card:nth-child(even) { margin-left: 0; }
    .svc__niche { width: min(46vw, 190px); }
    .svc__facade .svc__wing { width: min(17vw, 80px); margin-inline: 4px; }
    .svc__list { grid-template-columns: 1fr; }
    .svc__list li:not(.svc__pool) { border-right: 0 !important; border-top: 2px solid var(--channel); text-align: left; }
    .svc__list li:first-child { border-top: 0; }
    .svc__pool { display: none; }
  }

</style>

<script>
  import { motionOK, gsap } from '../../lib/motion';
  const root = document.querySelector<HTMLElement>('[data-svc]');
  if (root && motionOK()) {
    // only the fade is scrubbed: the blur stays fixed in CSS, so the board is not repainted on every scroll frame
    gsap.fromTo('[data-svc-board]', { opacity: 0.4 }, {
      opacity: 0.3, ease: 'none',
      scrollTrigger: { trigger: root, start: 'top top', end: '+=' + window.innerHeight * 0.9, scrub: 0.6, invalidateOnRefresh: true },
    });
  }
</script>
