---
// The full list of gardens, kept quiet: one large count, and the names set as short lines with room around them.
// Names with a case study are links (marble, underlined, arrow); the rest are muted text, so nothing looks clickable that isn't.
import { projectIndex } from '../../content/site';
import { wing, arrow } from '../../lib/ornament';
const groups = [
  { key: 'Farmhouse', label: 'Farmhouses' },
  { key: 'Residential', label: 'Residential' },
  { key: 'Public', label: 'Public and institutional' },
] as const;
const cols = groups.map((g) => ({ ...g, items: projectIndex.filter((p) => p.type === g.key) }));
const words = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const photographed = words[projectIndex.filter((p) => p.slug).length] ?? String(projectIndex.filter((p) => p.slug).length);
---
<section class="idx" aria-labelledby="idx-title">
  <div class="wrap idx__grid">
    <div class="idx__count">
      <p class="idx__num" aria-hidden="true">{projectIndex.length}</p>
      <h2 id="idx-title">gardens and counting</h2>
      <div class="idx__rule" aria-hidden="true"><span set:html={wing} /></div>
      <p class="idx__note">Across Raipur and Naya Raipur. The {photographed} underlined ones have a full story.</p>
    </div>
    <div class="idx__cols">
      {cols.map((col) => (
        <div class="idx__col">
          <h3>{col.label}</h3>
          <ul>
            {col.items.map((p) => (
              <li>
                {p.slug
                  ? <a href={`/projects/${p.slug}/`}>{p.name.split(' ').slice(0, -1).join(' ')} <span class="idx__last">{p.name.split(' ').at(-1)}<span class="idx__go" aria-hidden="true" set:html={arrow} /></span></a>
                  : <span class="idx__plain">{p.name}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .idx { background: var(--garden-950); border-top: var(--channel-line); padding-block: clamp(96px, 16vh, 180px); }
  .idx__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(48px, 8vw, 140px); align-items: start; }

  .idx__num { font: 400 clamp(6rem, 4rem + 9vw, 13rem)/0.8 var(--display); color: var(--marble); letter-spacing: -0.02em; }
  h2 { margin-top: 18px; font-size: var(--step-2); }
  .idx__rule { width: clamp(130px, 13vw, 170px); margin-top: 16px; color: #d08a63; }
  .idx__rule :global(svg) { display: block; width: 100%; height: auto; }
  .idx__note { margin-top: 18px; max-width: 30ch; font-size: var(--step--1); color: color-mix(in srgb, var(--marble) 72%, transparent); }

  .idx__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px clamp(28px, 4vw, 64px); padding-top: 12px; }
  h3 { font: 600 0.78rem/1.3 var(--text); letter-spacing: 0.12em; text-transform: uppercase; color: #e9b98f; margin-bottom: 22px; }
  .idx__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .idx__col li { font-size: var(--step-0); line-height: 1.35; }

  .idx__col a {
    display: inline; padding-block: 4px; text-decoration: none; color: var(--marble); box-decoration-break: clone; -webkit-box-decoration-break: clone;
    background: linear-gradient(rgb(233 201 160 / 0.6), rgb(233 201 160 / 0.6)) 0 100% / 100% 1px no-repeat;
    transition: background-size 0.3s var(--ease-out), color 0.2s var(--ease-out);
  }
  .idx__last { white-space: nowrap; } /* the arrow never drops onto a line of its own */
  .idx__go { display: inline-block; vertical-align: middle; margin-left: 8px; width: 20px; color: var(--gold); transition: transform 0.3s var(--ease-out); }
  .idx__go :global(svg) { display: block; width: 100%; height: auto; }
  @media (hover: hover) and (pointer: fine) {
    .idx__col a:hover { color: #f0d9b8; }
    .idx__col a:hover .idx__go { transform: translateX(4px); }
  }
  .idx__plain { color: color-mix(in srgb, var(--marble) 62%, transparent); }

  @media (max-width: 1099px) { .idx__grid { grid-template-columns: 1fr; } }
  @media (max-width: 699px) { .idx__cols { grid-template-columns: 1fr; gap: 36px; } }
  @media (prefers-reduced-motion: reduce) { .idx__col a, .idx__go { transition: none; } }
</style>
