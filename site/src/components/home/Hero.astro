---
import { Image } from 'astro:assets';
import photo from '../../assets/projects/khanuj-khanna/01.jpg';
import CallLink from '../CallLink.astro';
import Mark from '../Mark.astro';
import { wing } from '../../lib/ornament';
// One sharp, full-colour photo on every screen (the Khanuj Khanna pergola), set inside a double gold mount
// like a court painting. The words sit centred over it: the char-bagh mark, the title, the wing rule, one line, the actions.
// (The project pages also centre their title; the mount, the mark and the actions are what make this the front door.)
---
<section class="hero" data-hero data-dark-hero aria-labelledby="hero-title">
  <div class="hero__stage" data-hero-stage>
    <div class="hero__layer" data-depth="0.18">
      <Image src={photo} alt="A timber pergola with a glass roof over a deck, framed by climbers and tropical planting, at the Khanuj Khanna residence in Raipur" widths={[640, 960, 1280, 1920, 2400]} sizes="100vw" loading="eager" fetchpriority="high" quality={62} class="hero__img" />
    </div>
    <span class="hero__veil" aria-hidden="true"></span>
    <span class="hero__mount" aria-hidden="true"></span>
  </div>

  <div class="hero__course wrap">
    <span class="hero__mark" aria-hidden="true"><Mark /></span>
    <p class="hero__accent"><span class="deva" lang="hi">हरियाली</span> · Raipur, Chhattisgarh</p>
    <h1 id="hero-title">Landscape design and build</h1>
    <div class="hero__rule" aria-hidden="true"><span class="hero__wing--l" set:html={wing} /><i></i><span set:html={wing} /></div>
    <p class="hero__lede">Gardens, water, light and outdoor structures for homes, farmhouses and institutions. Drawn by our architects, built by our own teams.</p>
    <div class="hero__actions">
      <a class="btn btn--channel hero__btn" href="/contact/">Discuss your site</a>
      <CallLink />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; height: 100svh; min-height: 640px; background: var(--garden-950); overflow: hidden; color: var(--marble); }
  .hero__stage { position: absolute; inset: 0; overflow: hidden; isolation: isolate; }
  .hero__layer, .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__img { object-fit: cover; object-position: 50% 42%; }
  /* even, gentle darkening that deepens towards the centre-bottom where the words sit; the photo keeps its colour */
  .hero__stage::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      radial-gradient(ellipse 48% 46% at 50% 56%, rgb(8 24 16 / 0.7), rgb(8 24 16 / 0.42) 55%, transparent 100%),
      linear-gradient(to bottom, rgb(8 24 16 / 0.55), rgb(8 24 16 / 0.12) 26%, rgb(8 24 16 / 0.28) 60%, rgb(8 24 16 / 0.9));
  }
  /* a frosted oval behind the words only: the centre of the photo is softened and dimmed, fading out to the sharp edges,
     so the pergola still frames the screen and every line of text reads */
  .hero__veil {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    -webkit-backdrop-filter: blur(7px) brightness(0.82); backdrop-filter: blur(7px) brightness(0.82);
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 54%, #000 45%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 50% at 50% 54%, #000 45%, transparent 100%);
  }
  @media (max-width: 767px) {
    .hero__veil { -webkit-mask-image: radial-gradient(ellipse 80% 46% at 50% 62%, #000 50%, transparent 100%); mask-image: radial-gradient(ellipse 80% 46% at 50% 62%, #000 50%, transparent 100%); }
  }
  /* the double gold mount around the whole first screen */
  .hero__mount {
    position: absolute; z-index: 2; pointer-events: none;
    inset: calc(var(--bar-h) + 8px) clamp(12px, 2vw, 28px) clamp(12px, 2vw, 28px);
    border: 1px solid rgb(240 217 184 / 0.7); outline: 1px solid rgb(240 217 184 / 0.32); outline-offset: 6px;
  }

  .hero__course {
    position: absolute; left: 0; right: 0; bottom: clamp(48px, 10svh, 110px); z-index: 3;
    display: grid; justify-items: center; text-align: center;
  }
  .hero__mark { color: var(--gold); }
  .hero__mark :global(.mark) { width: 34px; height: 34px; }
  .hero__accent { margin-top: 14px; font-size: var(--step--1); letter-spacing: 0.02em; color: #f0d9b8; text-shadow: 0 1px 3px rgb(6 20 13 / 0.9), 0 0 18px rgb(6 20 13 / 0.8); }
  .hero__accent .deva { color: var(--gold); font-size: 1.15em; }
  h1 {
    margin-top: 10px; max-width: 13ch; font-size: clamp(2.6rem, 1.4rem + 5.2vw, 6.6rem); line-height: 0.98; letter-spacing: -0.01em;
    text-shadow: 0 2px 30px rgb(6 20 13 / 0.55);
  }
  .hero__rule { display: flex; align-items: center; gap: 6px; margin-top: 18px; color: var(--gold); }
  .hero__rule span { width: clamp(80px, 9vw, 130px); display: block; }
  .hero__rule :global(svg) { display: block; width: 100%; height: auto; }
  .hero__wing--l :global(svg) { transform: scaleX(-1); }
  .hero__rule i { width: 7px; height: 7px; background: currentColor; transform: rotate(45deg); flex: none; }
  .hero__lede { margin-top: 16px; max-width: 52ch; color: var(--marble); text-shadow: 0 1px 14px rgb(6 20 13 / 0.8); }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px 28px; margin-top: 26px; }
  .hero__btn { min-height: 52px; padding: 0 28px; }

  /* phones: the fixed action bar carries "Discuss your site", so the hero keeps the call button */
  @media (max-width: 767px) {
    .hero__img { object-position: 50% 40%; }
    .hero__course { bottom: calc(56px + 28px); }
    .hero__lede { font-size: var(--step--1); max-width: 34ch; }
    .hero__btn { display: none; }
    .hero__actions { margin-top: 18px; }
  }

  /* entrance: the view opens from the horizon line, then the words rise in order (CSS only, from first paint) */
  @media (prefers-reduced-motion: no-preference) {
    .hero__stage { animation: horizon 1.1s cubic-bezier(0.77, 0, 0.175, 1) both; }
    .hero__mount { animation: fade 0.9s cubic-bezier(0.23, 1, 0.32, 1) 0.8s both; }
    .hero__course > * { animation: rise 0.9s cubic-bezier(0.23, 1, 0.32, 1) both; animation-delay: calc(0.45s + var(--n, 0) * 70ms); }
    .hero__accent { --n: 1; } h1 { --n: 2; } .hero__rule { --n: 3; } .hero__lede { --n: 4; } .hero__actions { --n: 5; }
  }
  /* the homepage gateway holds the entrance until the page is ready (see Preloader.astro) */
  :global(html.pl-wait) .hero__stage, :global(html.pl-wait) .hero__mount, :global(html.pl-wait) .hero__course > * { animation-play-state: paused; }
  @keyframes horizon { from { clip-path: inset(46% 0 46% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes rise { from { transform: translateY(18px); opacity: 0; } }
  @keyframes fade { from { opacity: 0; } }
</style>

<script>
  import { motionOK, gsap } from '../../lib/motion';
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  if (stage && motionOK() && window.matchMedia('(min-width: 900px)').matches) {
    stage.querySelectorAll<HTMLElement>('[data-depth]').forEach((el) => {
      gsap.to(el, {
        yPercent: Number(el.dataset.depth) * 30, ease: 'none',
        scrollTrigger: { trigger: stage, start: 'top top', end: 'bottom top', scrub: true },
      });
    });
  }
</script>
