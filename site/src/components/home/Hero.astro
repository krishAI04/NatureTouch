---
import { Image, getImage } from 'astro:assets';
import photo from '../../assets/hero/pergola-photo.jpg';
import walkM from '../../assets/hero/garden-walk-m.jpg';
import front from '../../assets/hero/pergola-front.png';
import CallLink from '../CallLink.astro';
// phones get their own photo: the Khanuj Khanna palm walk, a tall view that reads at phone size
// (the pergola needs a wide frame; cropped tall it is mostly hanging fans). Upscaled crop, see CREATIVE-LOG.
const phone = await getImage({ src: walkM, widths: [600, 900, 1200], format: 'webp', quality: 60 });
// a 1×1 blank, so phones never download the pergola cut-out layer they don't show
const blank = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
---
<section class="hero" data-hero data-dark-hero aria-labelledby="hero-title">
  <div class="hero__stage" data-hero-stage>
    <div class="hero__layer hero__layer--back" data-depth="0.25">
      <picture>
        <source media="(max-width: 767px)" srcset={phone.srcSet.attribute} sizes="100vw" type="image/webp" />
        <Image src={photo} alt="A garden by Nature Touch at the Khanuj Khanna residence in Raipur: a timber pergola on wide screens, a palm-lined spiral walk on phones" widths={[800, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={55} class="hero__img" />
      </picture>
    </div>
    <div class="hero__layer" data-depth="0.25">
      <picture>
        <source media="(max-width: 767px)" srcset={blank} />
        <Image src={front} alt="" widths={[800, 1280, 1920, 2400]} sizes="100vw" loading="eager" class="hero__img hero__front" />
      </picture>
    </div>
    <p class="hero__big" aria-hidden="true" data-depth="0.5">Go Green</p>
  </div>

  <div class="hero__course wrap">
    <div class="hero__text">
      <p class="hero__accent"><span class="deva" lang="hi">हरियाली</span></p>
      <h1 id="hero-title">Landscape design and build in Raipur</h1>
      <p class="hero__lede">Gardens, water features, lighting and outdoor structures for homes, farmhouses and institutions across Chhattisgarh. Drawn by our architects, built by our own teams.</p>
    </div>
    <div class="hero__actions">
      <a class="btn btn--channel" href="/contact/">Discuss your site</a>
      <CallLink />
      <CallLink kind="whatsapp" class="hero__wa" />
    </div>
  </div>
</section>

<style>
  /* the photo fills the whole first screen; the text sits over its darkened lower edge */
  .hero { position: relative; height: 100svh; min-height: 620px; background: var(--garden-950); overflow: hidden; }
  .hero__stage { position: absolute; inset: var(--bar-h) 0 0 0; overflow: hidden; isolation: isolate; }
  .hero__layer, .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__img { object-fit: cover; object-position: 50% 38%; }
  .hero__layer:first-child { z-index: -1; }
  /* depth of field: the garden behind the pergola is softened and dimmed; the pergola stays sharp */
  .hero__layer--back :global(img) { filter: blur(2px) brightness(0.6) saturate(1.05); }
  .hero__stage::after {
    content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: linear-gradient(to bottom, transparent 38%, rgb(11 32 22 / 0.86) 66%, var(--garden-950) 100%);
  }
  .hero__big {
    position: absolute; left: 0; right: 0; top: 11%; margin: 0; text-align: center; z-index: 1;
    font: 400 clamp(3.4rem, min(11vw, 20svh), 12rem)/0.9 var(--display); letter-spacing: -0.015em;
    color: var(--marble); text-shadow: 0 2px 6px rgb(6 20 13 / 0.35), 0 8px 48px rgb(6 20 13 / 0.55); white-space: nowrap; pointer-events: none;
  }

  .hero__course {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 3;
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 20px 48px;
    padding-bottom: clamp(28px, 5vh, 56px);
  }
  .hero__accent { color: var(--channel); font-size: 1.15rem; margin-bottom: 6px; }
  h1 { font-size: clamp(2rem, 1.3rem + 2.3vw, 3.6rem); max-width: 20ch; }
  .hero__lede { margin-top: 10px; max-width: 58ch; color: var(--marble); text-shadow: 0 1px 14px rgb(6 20 13 / 0.7); }
  .hero__text h1 { text-shadow: 0 2px 24px rgb(6 20 13 / 0.5); }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; }
  .hero__actions :global(.hero__wa) { display: inline-flex; }

  @media (max-width: 899px) {
    .hero__course { grid-template-columns: 1fr; }
    .hero__img { object-position: 50% 36%; }
    .hero__big { top: 7%; font-size: clamp(3rem, 18vw, 6.5rem); }
    .hero__stage::after { background: linear-gradient(to bottom, transparent 30%, rgb(11 32 22 / 0.8) 58%, var(--garden-950) 100%); }
  }
  /* phones: the fixed action bar carries "Discuss your site", so the hero keeps only the phone link */
  @media (max-width: 767px) {
    /* the palm walk, sharp and lit; no pergola layer, so no depth blur */
    .hero__layer--back :global(img) { filter: brightness(0.78) saturate(1.05); object-position: 50% 55%; }
    .hero__layer:not(.hero__layer--back) { display: none; }
    .hero__actions .btn, .hero__actions :global(.hero__wa) { display: none; }
    .hero__lede { font-size: var(--step--1); }
    .hero__course { padding-bottom: 80px; }
  }

  /* entrance: the view opens from the horizon line (CSS only, from first paint) */
  @media (prefers-reduced-motion: no-preference) {
    .hero__stage { animation: horizon 1.1s cubic-bezier(0.77, 0, 0.175, 1) both; }
    .hero__big { animation: rise 1.2s cubic-bezier(0.23, 1, 0.32, 1) 0.35s both; }
    .hero__front { animation: lift 1.2s cubic-bezier(0.23, 1, 0.32, 1) 0.2s both; }
    .hero__course { animation: fade 0.7s cubic-bezier(0.23, 1, 0.32, 1) 0.7s both; }
  }
  /* the homepage gateway holds the entrance until the page is ready (see Preloader.astro) */
  :global(html.pl-wait) .hero__stage, :global(html.pl-wait) .hero__big, :global(html.pl-wait) .hero__front, :global(html.pl-wait) .hero__course { animation-play-state: paused; }
  @keyframes horizon { from { clip-path: inset(46% 0 46% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes rise { from { transform: translateY(18%); opacity: 0.2; } }
  @keyframes lift { from { transform: translateY(14px); } }
  @keyframes fade { from { opacity: 0; } }
</style>

<script>
  import { motionOK, gsap } from '../../lib/motion';
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  if (stage && motionOK() && window.matchMedia('(min-width: 900px)').matches) {
    stage.querySelectorAll<HTMLElement>('[data-depth]').forEach((el) => {
      gsap.to(el, {
        yPercent: Number(el.dataset.depth) * 30, ease: 'none',
        scrollTrigger: { trigger: stage, start: 'top top', end: 'bottom top', scrub: true },
      });
    });
  }
</script>
