---
import { Image } from 'astro:assets';
const logos = import.meta.glob<{ default: ImageMetadata }>('../../assets/clients/*.png', { eager: true });
const names: Record<string, string> = {
  jspl: 'Jindal Steel and Power', nrda: 'Nava Raipur Atal Nagar Development Authority', wallfort: 'Wallfort',
  avinash: 'Avinash Group', singhania: 'Singhania Buildcon Group', 'raipur-smart-city': 'Raipur Smart City',
};
const order = ['jspl', 'nrda', 'raipur-smart-city', 'avinash', 'wallfort', 'singhania'];
const items = order.map((k) => ({ k, src: logos[`../../assets/clients/${k}.png`].default, name: names[k] }));
---
<section class="proof" aria-labelledby="proof-title">
  <div class="wrap proof__row">
    <h2 id="proof-title" class="proof__title">Gardens for Raipur's institutions, developers and families</h2>
    <ul class="proof__logos">
      {items.map((l) => (
        <li><Image src={l.src} alt={l.name} height={56} widths={[160, 320]} sizes="160px" class="proof__logo" /></li>
      ))}
    </ul>
    <p class="proof__partner">Irrigation systems with <strong>Rain Bird</strong>, our associate.</p>
  </div>
</section>

<style>
  .proof { background: var(--garden-950); border-top: var(--channel-line); padding-block: clamp(48px, 8vh, 88px); }
  .proof__row { display: grid; gap: 28px; }
  .proof__title { font-size: var(--step-1); max-width: 30ch; }
  .proof__logos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 24px 40px; align-items: center; }
  .proof__logo { height: clamp(34px, 3.6vw, 52px); width: auto; max-width: 100%; object-fit: contain; object-position: left center; opacity: 0.86; transition: opacity 0.3s var(--ease-out); }
  .proof__logos li:hover .proof__logo { opacity: 1; }
  .proof__partner { color: color-mix(in srgb, var(--marble) 80%, transparent); font-size: var(--step--1); }
  .proof__partner strong { color: var(--marble); font-weight: 600; }
  @media (max-width: 899px) { .proof__logos { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
