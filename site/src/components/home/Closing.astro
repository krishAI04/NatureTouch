---
import { company } from '../../content/site';
import CallLink from '../CallLink.astro';
---
<section class="close" aria-labelledby="close-title">
  <div class="wrap close__grid">
    <h2 id="close-title">Tell us about your plot.<br />We'll tell you what it can become.</h2>
    <div class="close__actions">
      <a class="btn btn--channel close__btn" href="/contact/">Discuss your site</a>
      <CallLink size="lg" />
      <CallLink kind="whatsapp" size="lg" />
      <p class="close__addr">{company.address}</p>
    </div>
  </div>
</section>

<style>
  .close { background: var(--garden-800); border-top: var(--channel-line); padding-block: clamp(80px, 14vh, 160px); }
  .close__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 40px clamp(32px, 6vw, 96px); align-items: end; }
  h2 { font-size: var(--step-3); max-width: 18ch; }
  .close__actions { display: grid; gap: 10px; justify-items: start; }
  .close__btn { min-height: 56px; padding: 0 30px; font-size: var(--step-0); margin-bottom: 8px; }
  .close__addr { margin-top: 8px; font-size: var(--step--1); color: color-mix(in srgb, var(--marble) 80%, transparent); max-width: 36ch; }
  @media (max-width: 899px) { .close__grid { grid-template-columns: 1fr; } }
</style>
