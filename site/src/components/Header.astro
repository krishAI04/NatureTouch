---
import Mark from './Mark.astro';
import CallLink from './CallLink.astro';
import { wing, arrow } from '../lib/ornament';
const numerals = ['I', 'II', 'III', 'IV'];
const path = Astro.url.pathname;
const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/services/', label: 'Services' },
  { href: '/nursery/', label: 'Nursery' },
  { href: '/about/', label: 'About' },
];
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---
<header class="bar" data-bar>
  <a class="wordmark" href="/" aria-label="Nature Touch, home">
    <Mark />
    <span translate="no">Nature Touch</span>
  </a>
  <nav class="nav" aria-label="Main">
    <ul>
      {links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
    </ul>
    <a class="btn btn--small" href="/contact/">Discuss your site</a>
  </nav>
  <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="menu" data-menu-open>
    <span>Menu</span>
    <Mark />
  </button>
</header>

<dialog class="menu" id="menu" aria-label="Site menu" data-menu>
  <div class="menu__panel">
    <div class="menu__top">
      <p class="menu__title">Menu</p>
      <button class="menu__close" type="button" data-menu-close aria-label="Close menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
    </div>
    <div class="menu__rule" aria-hidden="true"><i></i><span set:html={wing} /></div>
    <nav aria-label="Main">
      <ul class="menu__list">
        {links.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href} aria-current={current(l.href)}>
              <span class="menu__num" aria-hidden="true">{numerals[i]}</span>
              <span class="menu__name">{l.label}</span>
              <span class="menu__go" aria-hidden="true" set:html={arrow} />
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--channel menu__cta" href="/contact/">Discuss your site</a>
    <div class="menu__foot">
      <CallLink />
      <CallLink kind="whatsapp" />
    </div>
  </div>
</dialog>

<style>
  .bar {
    position: fixed; inset: 0 0 auto; z-index: 100; height: var(--bar-h);
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 0 var(--gutter); color: var(--marble);
    transition: transform 0.4s var(--ease-out), background-color 0.3s var(--ease-out);
  }
  .bar:global(.is-solid) { background: color-mix(in srgb, var(--garden-950) 92%, transparent); }
  .bar:global(.is-hidden) { transform: translateY(-100%); }
  .wordmark { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; text-decoration: none; font: 400 1.35rem/1 var(--display); }
  .nav { display: flex; align-items: center; gap: clamp(16px, 2.4vw, 40px); }
  .nav ul { display: flex; gap: clamp(14px, 2vw, 32px); margin: 0; padding: 0; list-style: none; }
  .nav ul a {
    display: inline-block; padding: 12px 0; text-decoration: none; font-weight: 500; font-size: var(--step--1);
    background: linear-gradient(var(--channel), var(--channel)) 0 calc(100% - 6px) / 0% 2px no-repeat;
    transition: background-size 0.3s var(--ease-out);
  }
  .nav ul a:hover, .nav ul a[aria-current='page'] { background-size: 100% 2px; }
  .btn--small { min-height: 44px; padding: 0 20px; }
  .menu-btn {
    display: none; align-items: center; gap: 10px; min-height: 44px; padding: 0 4px;
    background: none; border: 0; color: inherit; cursor: pointer; font: 600 var(--step--1)/1 var(--text);
  }
  @media (max-width: 899px) {
    .nav { display: none; }
    .menu-btn { display: inline-flex; }
  }

  /* the menu: a classic panel that slides in from the right over a dimmed page */
  .menu {
    position: fixed; inset: 0 0 0 auto; width: min(88vw, 400px); height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0; background: var(--garden-950); color: var(--marble); overscroll-behavior: contain;
    box-shadow: inset 1px 0 0 rgb(233 201 160 / 0.32), -24px 0 60px rgb(0 0 0 / 0.35);
    transform: translateX(100%); transition: transform 0.28s var(--ease-out);
  }
  .menu.is-in { transform: none; transition: transform 0.45s cubic-bezier(0.32, 0.72, 0, 1); }
  .menu::backdrop { background: rgb(6 20 13 / 0); transition: background-color 0.3s var(--ease-out); }
  .menu.is-in::backdrop { background: rgb(6 20 13 / 0.62); }
  .menu__panel { height: 100%; display: flex; flex-direction: column; gap: 22px; padding: 0 24px max(24px, env(safe-area-inset-bottom)); overflow-y: auto; }
  .menu__top { display: flex; align-items: center; justify-content: space-between; min-height: var(--bar-h); }
  .menu__title { font: 400 1.5rem/1 var(--display); }
  .menu__close {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; padding: 0;
    background: none; color: var(--marble); border: 1px solid color-mix(in srgb, var(--marble) 35%, transparent);
    transition: background-color 0.2s var(--ease-out), transform 0.16s var(--ease-out);
  }
  .menu__close svg { width: 20px; height: 20px; }
  .menu__close:active { transform: scale(0.95); }
  .menu__rule { display: flex; align-items: center; gap: 6px; color: var(--sandstone-soft); margin-top: -10px; }
  .menu__rule span { width: 120px; display: block; }
  .menu__rule :global(svg) { display: block; width: 100%; height: auto; }
  .menu__rule i { width: 7px; height: 7px; background: currentColor; transform: rotate(45deg); flex: none; }
  /* each page a row: numeral, name, arrow, a gold hairline between */
  .menu__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgb(233 201 160 / 0.24); }
  .menu__list li { border-bottom: 1px solid rgb(233 201 160 / 0.24); }
  .menu__list a {
    display: grid; grid-template-columns: 2.2em 1fr auto; align-items: center; min-height: 64px; padding: 0 4px; text-decoration: none;
    color: var(--marble); transition: background-color 0.2s var(--ease-out);
  }
  .menu__num { font: 400 0.9rem/1 var(--display); color: var(--gold); }
  .menu__name { font: 400 1.85rem/1 var(--display); }
  .menu__go { width: 28px; color: var(--gold); transition: transform 0.25s var(--ease-out); }
  .menu__go :global(svg) { display: block; width: 100%; height: auto; }
  .menu__list a:active { background: rgb(233 201 160 / 0.08); }
  @media (hover: hover) and (pointer: fine) { .menu__list a:hover .menu__go { transform: translateX(4px); } .menu__close:hover { background: rgb(238 240 235 / 0.08); } }
  .menu__list a:focus-visible .menu__go { transform: translateX(4px); }
  .menu__list a[aria-current='page'] { background: rgb(233 201 160 / 0.06); }
  .menu__list a[aria-current='page'] .menu__num { font-size: 0; }
  .menu__list a[aria-current='page'] .menu__num::before { content: ''; display: block; width: 8px; height: 8px; background: var(--gold); transform: rotate(45deg); }
  .menu__cta { min-height: 52px; justify-content: center; }
  .menu__foot { margin-top: auto; display: grid; gap: 8px; padding-top: 18px; border-top: 1px solid rgb(233 201 160 / 0.24); }
  @media (prefers-reduced-motion: no-preference) {
    .menu.is-in .menu__list li { animation: menu-in 0.4s var(--ease-out) both; animation-delay: calc(80ms + var(--i) * 40ms); }
  }
  @keyframes menu-in { from { opacity: 0; transform: translateX(16px); } }
  @media (prefers-reduced-motion: reduce) { .menu, .menu.is-in, .menu::backdrop { transition: none; } }
  @media (prefers-reduced-motion: reduce) { .bar { transition: none; } }
</style>

<script>
  import { initHeader, getLenis } from '../lib/motion';
  const bar = document.querySelector<HTMLElement>('[data-bar]');
  if (bar) initHeader(bar);
  const dlg = document.querySelector<HTMLDialogElement>('[data-menu]');
  const open = document.querySelector('[data-menu-open]');
  // slide in: open the dialog off-screen, then add the class that brings it in
  open?.addEventListener('click', () => {
    if (!dlg) return;
    dlg.showModal(); getLenis()?.stop();
    void dlg.offsetWidth; // apply the off-screen position first so the slide runs
    dlg.classList.add('is-in');
  });
  // slide out, then close; with reduced motion it closes at once
  const shut = () => {
    if (!dlg?.open || !dlg.classList.contains('is-in')) return;
    dlg.classList.remove('is-in');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    setTimeout(() => dlg.close(), reduce ? 0 : 280);
  };
  dlg?.querySelector('[data-menu-close]')?.addEventListener('click', shut);
  dlg?.addEventListener('cancel', (e) => { e.preventDefault(); shut(); });
  // focus goes back to the Menu button after the browser's own focus restore
  dlg?.addEventListener('close', () => { getLenis()?.start(); setTimeout(() => (open as HTMLElement)?.focus(), 0); });
  // a tap on the dimmed page (the backdrop) or on a link closes the panel
  dlg?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t === dlg || t.closest('a')) shut();
  });
</script>
