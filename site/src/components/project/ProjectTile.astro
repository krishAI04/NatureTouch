---
// A framed project tile: photo inside a double gold hairline, name over a flourish.
// The photo carries a view-transition name so it grows into the case-study hero.
import { Image } from 'astro:assets';
import type { Project } from '../../content/site';
import { coverOf } from '../../lib/project-photos';
import { wing } from '../../lib/ornament';
interface Props { project: Project; n: number; total: number }
const { project: p, n, total } = Astro.props;
---
<a class="tile" href={`/projects/${p.slug}/`}>
  <span class="tile__media">
    <Image src={coverOf(p.slug)} alt="" widths={[480, 720, 1080]} sizes="(min-width: 1100px) 30vw, (min-width: 700px) 46vw, 92vw" class="tile__img" style={`view-transition-name: p-${p.slug}; view-transition-class: proj`} loading={n <= 3 ? 'eager' : 'lazy'} />
  </span>
  <span class="tile__n" aria-hidden="true">{String(n).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
  <span class="tile__label">
    <span class="tile__name">{p.name}</span>
    <span class="tile__flourish" aria-hidden="true"><span set:html={wing} class="l" /><i></i><span set:html={wing} /></span>
    <span class="tile__meta">{p.type} · {p.place}</span>
  </span>
</a>

<style>
  .tile { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 4px; text-decoration: none; background: var(--garden-950); }
  .tile__media, .tile__img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .tile__img { object-fit: cover; transition: transform 0.9s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .tile:hover .tile__img { transform: scale(1.04); } }
  .tile::after {
    content: ''; position: absolute; inset: 10px; z-index: 2; pointer-events: none; border-radius: 2px;
    border: 1px solid rgb(233 201 160 / 0.75); outline: 1px solid rgb(233 201 160 / 0.4); outline-offset: 4px;
  }
  .tile__n { position: absolute; top: 24px; left: 50%; transform: translateX(-50%); z-index: 3; padding: 6px 12px; border-radius: 999px; background: rgb(8 24 16 / 0.8); font: 500 0.75rem/1 var(--text); letter-spacing: 0.14em; color: #f0d9b8; }
  .tile__label {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: 80px 26px 30px;
    display: grid; gap: 4px; justify-items: center; text-align: center;
    background: linear-gradient(to top, rgb(8 24 16 / 0.9), transparent);
  }
  .tile__name { font: 400 var(--step-1)/1.1 var(--display); }
  .tile__flourish { display: flex; align-items: center; gap: 4px; color: var(--gold); }
  .tile__flourish > span { width: 52px; }
  .tile__flourish :global(svg) { display: block; width: 100%; height: auto; }
  .tile__flourish .l :global(svg) { transform: scaleX(-1); }
  .tile__flourish i { width: 5px; height: 5px; background: currentColor; transform: rotate(45deg); flex: none; }
  .tile__meta { font-size: var(--step--1); color: color-mix(in srgb, var(--marble) 86%, transparent); }
  .tile:focus-visible { outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .tile__img { transition: none; } }
</style>
