---
// The char-bagh mark: a walled square, two crossing channels, a central pool.
const { class: cls = '' } = Astro.props;
---
<svg class={`mark ${cls}`} viewBox="0 0 24 24" aria-hidden="true">
  <rect x="2.5" y="2.5" width="19" height="19" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
  <path d="M12 2.5v6.5M12 15v6.5M2.5 12h6.5M15 12h6.5" stroke="currentColor" stroke-width="1.5" />
  <rect x="9.5" y="9.5" width="5" height="5" rx="0.5" fill="currentColor" />
</svg>
<style>
  .mark { width: 22px; height: 22px; flex: none; }
</style>
